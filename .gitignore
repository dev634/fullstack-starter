# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

/app/generated/prisma

# Local Claude Code config stays local (launch.json, settings.local.json),
# but the shared subagent definitions are versioned — CLAUDE.md's pipeline
# references them, so they belong in the repo.
.claude/*
!.claude/agents/
# A nested .claude (a working-directory CLI config) stays local.
actions/.claude/