# Copy this file to `.env` on the VPS (same folder as docker-compose.prod.yml)
# and fill in real values. This file is read by both the db and web services.

# --- Postgres (db service) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- App (web service) ---
# IMPORTANT: the host is the compose service name "db", not localhost.
DATABASE_URL="postgresql://app:change_me_to_a_strong_password@db:5432/app?schema=public"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="generate_a_secret"

# Required when running behind a reverse proxy that terminates TLS, so
# Auth.js trusts the forwarded Host/Proto headers. Make sure your proxy
# forwards X-Forwarded-Proto and X-Forwarded-Host to the app.
AUTH_TRUST_HOST=true

# Optional: pin the public URL (recommended in production)
# AUTH_URL="https://your-domain.com"

# Required only if you use the client photo upload feature.
# Get this from your Cloudinary dashboard → "API Environment variable".
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# Required for password-reset emails to actually be delivered. Without it,
# reset links are only logged to the server console (fine for local dev,
# not for real users). Get a key at https://resend.com (free tier).
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="onboarding@resend.dev"

# Optional: server-side error tracking (Sentry). Leave unset to disable —
# the SDK no-ops without a DSN. Free tier at https://sentry.io.
# SENTRY_DSN="https://your_key@o0.ingest.sentry.io/0"

NODE_ENV=production
