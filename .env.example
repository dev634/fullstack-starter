POSTGRES_DB= "your database name"
POSTGRES_USER= "your database user"
POSTGRES_PASSWORD= "your database password"
DATABASE_URL="postgresql://your_database_user:your_database_password@localhost:5432/your_database_name?schema=public"

# Auth.js (NextAuth v5) — secret used to encrypt the JWT session.
# Generate one with: npx auth secret
AUTH_SECRET="your auth secret"

# Cloudinary — image storage for client photos.
# Copy the "API Environment variable" from your Cloudinary dashboard:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# Optional: password-reset emails. Without it, reset links are just logged
# to the console — fine for local dev. Get a key at https://resend.com.
# RESEND_API_KEY="re_your_api_key"
# EMAIL_FROM="onboarding@resend.dev"

# Optional: server-side error tracking (Sentry). Leave unset to disable —
# the SDK no-ops without a DSN. Free tier at https://sentry.io.
# SENTRY_DSN="https://your_key@o0.ingest.sentry.io/0"

# Optional: delivery note scanning (Stock Matériel > "Scanner un bulletin").
# Without it, the scan button returns a clear "not configured" error instead
# of failing obscurely. Get a key at https://console.anthropic.com.
# ANTHROPIC_API_KEY="sk-ant-your_api_key"