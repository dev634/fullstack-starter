// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  PROSPECT
  CLIENT
  INACTIVE
}

// Persistent, DB-backed rate limiting (login/reset attempts). Deliberately
// just timestamped rows per key — "how many in the last N ms" is a plain
// count query, and this must be a genuine single source of truth shared
// across every request: Next.js can compile the same module into separate
// bundles for Server Actions vs Route Handlers, so a plain in-memory Map is
// NOT a reliable process-wide singleton and silently under-counts failures
// made through different call paths.
model RateLimitAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Client {
  id          Int          @id @default(autoincrement())
  companyName String
  firstName   String
  lastName    String
  address     String
  zipCode     String
  city        String
  country     String
  email       String       @unique
  photoUrl    String?
  phone       String?
  website     String?
  status      ClientStatus @default(PROSPECT)
  deletedAt   DateTime?
  projects    Project[]
}

enum ProjectStatus {
  ETUDE // étude / devis en cours
  SIGNE // devis signé
  EN_COURS // installation en cours
  RACCORDEMENT // en attente de raccordement / mise en service
  TERMINE // chantier terminé
  ANNULE // annulé
}

enum ProjectType {
  CENTRALE_AU_SOL
  OMBRIERE
  TOITURE
  AUTRE
}

model Project {
  id             Int                   @id @default(autoincrement())
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       Int
  name           String
  type           ProjectType           @default(AUTRE)
  status         ProjectStatus         @default(ETUDE)
  // Puissance crête en kWc, budget en euros — nullable tant que non chiffrés.
  power          Float?
  budget         Float?
  // Adresse du chantier : peut différer de l'adresse de facturation du client.
  address        String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tasks          ProjectTask[]
  taskGroups     ProjectTaskGroup[]
  taskCategories ProjectTaskCategory[]
  folders        ProjectFolder[]
  files          ProjectFile[]
  materials      ProjectMaterial[]
  interventions  Intervention[]
}

model ProjectTask {
  id             Int               @id @default(autoincrement())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      Int
  // Set when this task was bulk-generated as part of a named series (see
  // ProjectTaskGroup) — null for a regular, individually-added task.
  group          ProjectTaskGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        Int?
  title          String
  done           Boolean           @default(false)
  // Optional quantity tracking for a standalone (ungrouped) task — when
  // quantityTarget is set, progress is entered as a count (quantityDone out
  // of quantityTarget) instead of a plain checkbox; done is kept in sync
  // (true once quantityDone reaches quantityTarget). Null for series tasks
  // and for standalone tasks that just use the checkbox.
  quantityTarget Int?
  quantityDone   Int?
  dueDate        DateTime?
  createdAt      DateTime          @default(now())
  materials      ProjectMaterial[]
  // Optional direct link to a category (e.g. "Toiture") for a standalone
  // task, same grouping series already have via ProjectTaskGroup.categoryId
  // — lets a lone quantity-tracked task sit alongside series under the same
  // category without needing to be wrapped in its own series.
  category       ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     Int?
}

// A named, pattern-generated batch of tasks (e.g. "Strings onduleur" ->
// "String 1".."String 27"). Shown as a single row in the task list; deleting
// the group cascades to its tasks.
model ProjectTaskGroup {
  id         Int                  @id @default(autoincrement())
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  name       String
  pattern    String
  createdAt  DateTime             @default(now())
  tasks      ProjectTask[]
  materials  ProjectMaterial[]
  // Optional higher-level grouping of several series together (e.g. a
  // "Toiture" category containing the "Strings onduleur" and "Fixations"
  // series). SetNull rather than Cascade: deleting the category shouldn't
  // delete the series, just ungroup it.
  category   ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?
}

// Groups several ProjectTaskGroup series under one named category (e.g.
// "Toiture" containing "Strings onduleur" + "Fixations").
model ProjectTaskCategory {
  id        Int                @id @default(autoincrement())
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  createdAt DateTime           @default(now())
  groups    ProjectTaskGroup[]
  tasks     ProjectTask[]
  materials ProjectMaterial[]
}

// Self-referential tree: a folder can live at the project root (parentId
// null) or nest inside another folder of the same project.
model ProjectFolder {
  id        Int             @id @default(autoincrement())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  ProjectFolder[] @relation("FolderChildren")
  files     ProjectFile[]
  createdAt DateTime        @default(now())
}

// Inventory line for a project's equipment/material (panels, inverters,
// mounting hardware, ...). Quantity-only tracking — no per-unit status.
model ProjectMaterial {
  id               Int                  @id @default(autoincrement())
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        Int
  name             String
  // Quantity currently in stock.
  quantity         Float
  unit             String?
  supplierName     String?
  reference        String?
  // Optional link to the task, whole task series, or whole task category
  // this material is needed for (mutually exclusive) — when set,
  // requiredQuantity drives the stock indicator (red/orange/green in the
  // UI). SetNull rather than Cascade: deleting the task/series/category
  // shouldn't delete the material, just unlink it.
  task             ProjectTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId           Int?
  taskGroup        ProjectTaskGroup?    @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)
  taskGroupId      Int?
  taskCategory     ProjectTaskCategory? @relation(fields: [taskCategoryId], references: [id], onDelete: SetNull)
  taskCategoryId   Int?
  requiredQuantity Float?
  createdAt        DateTime             @default(now())
}

enum InterventionStatus {
  PLANIFIEE
  FAITE
  ANNULEE
}

// A future on-site visit for a project (maintenance, inspection, install
// follow-up, ...) — independent of the task list, just a scheduled date +
// description tracked through to completion.
model Intervention {
  id          Int                @id @default(autoincrement())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  scheduledAt DateTime
  description String
  technician  String?
  status      InterventionStatus @default(PLANIFIEE)
  createdAt   DateTime           @default(now())
}

model ProjectFile {
  id        Int            @id @default(autoincrement())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  Int?
  name      String
  url       String
  publicId  String
  size      Int?
  mimeType  String?
  createdAt DateTime       @default(now())
}

enum Role {
  SUPERADMIN
  ADMIN
  VIEWER
}

model User {
  id          Int                  @id @default(autoincrement())
  email       String               @unique
  password    String
  name        String?
  role        Role                 @default(ADMIN)
  createdAt   DateTime             @default(now())
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Singleton row (always id=1) holding app-wide branding/theme, configurable
// by a SUPERADMIN. One row for the whole app — this is a single-tenant
// starter, not a multi-tenant SaaS.
model AppSettings {
  id           Int      @id @default(1)
  appName      String   @default("Fullstack Starter")
  logoUrl      String?
  logoPublicId String?
  primaryColor String   @default("#3b82f6")
  accentColor  String   @default("#8b5cf6")
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  PERMANENTLY_DELETED
  IMPORTED
}

// No FK to Client: entries must survive a permanent deletion, so the client
// name is stored as a snapshot rather than joined at read time.
model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  clientId   Int?
  clientName String
  actorEmail String
  createdAt  DateTime       @default(now())
}

// Same snapshot approach as ActivityLog, for the projects module.
model ProjectActivityLog {
  id          Int            @id @default(autoincrement())
  action      ActivityAction
  projectId   Int?
  projectName String
  actorEmail  String
  createdAt   DateTime       @default(now())
}
