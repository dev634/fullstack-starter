// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  // Enables declaring PostgreSQL extensions in the datasource below, so the
  // pg_trgm extension is part of the schema and does not read as drift.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  // Trigram matching for the case-insensitive `contains` (ILIKE '%term%')
  // list searches; backs the GIN indexes declared on Client/Project below.
  extensions = [pg_trgm]
}

enum ClientStatus {
  PROSPECT
  CLIENT
  INACTIVE
}

// Persistent, DB-backed rate limiting (login/reset attempts). Deliberately
// just timestamped rows per key — "how many in the last N ms" is a plain
// count query, and this must be a genuine single source of truth shared
// across every request: Next.js can compile the same module into separate
// bundles for Server Actions vs Route Handlers, so a plain in-memory Map is
// NOT a reliable process-wide singleton and silently under-counts failures
// made through different call paths.
model RateLimitAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// An organisation/entreprise (company). Identified by companyName; its people
// live in Contact. email/phone are the company's own switchboard details,
// distinct from any contact's. The former person-identity columns
// (firstName/lastName) were migrated onto a primary Contact and dropped.
model Client {
  id          Int          @id @default(autoincrement())
  companyName String
  address     String
  zipCode     String
  city        String
  country     String
  email       String       @unique
  photoUrl    String?
  phone       String?
  website     String?
  status      ClientStatus @default(PROSPECT)
  deletedAt   DateTime?
  projects    Project[]
  contacts    Contact[]

  // GIN trigram indexes serving the case-insensitive `contains` filter in
  // repository/clients.ts::search (ILIKE '%term%'), which a btree cannot
  // accelerate. Require the pg_trgm extension declared on the datasource.
  @@index([companyName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_companyName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Client_email_trgm_idx")
}

// A person attached to an organisation — many per organisation. Each Client's
// former firstName/lastName/email/phone were migrated onto a primary Contact.
// onDelete Cascade: deleting the organisation removes its contacts.
model Contact {
  id            Int          @id @default(autoincrement())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      Int
  firstName     String
  lastName      String
  email         String?
  phone         String?
  // The contact's job function, picked from the managed list (see JobFunction).
  // SetNull so deleting a function just clears it from its contacts.
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId Int?
  isPrimary     Boolean      @default(false)
  // Optional client-portal login for this contact (role CLIENT). SetNull so
  // deleting the login doesn't delete the contact.
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?         @unique
  // Projects of this contact's company the portal login may see (a subset).
  projects      Project[]    @relation("ContactProjects")
  createdAt     DateTime     @default(now())

  @@index([clientId])
  @@index([jobFunctionId])
}

enum ProjectStatus {
  ETUDE // étude / devis en cours
  SIGNE // devis signé
  EN_COURS // installation en cours
  RACCORDEMENT // en attente de raccordement / mise en service
  TERMINE // chantier terminé
  ANNULE // annulé
}

enum ProjectType {
  CENTRALE_AU_SOL
  OMBRIERE
  TOITURE
  AUTRE
}

model Project {
  id             Int                   @id @default(autoincrement())
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       Int
  name           String
  // Numéro d'affaire : référence métier libre du projet (nullable).
  businessNumber String?
  type           ProjectType           @default(AUTRE)
  status         ProjectStatus         @default(ETUDE)
  // Puissance crête en kWc, budget en euros — nullable tant que non chiffrés.
  power          Float?
  budget         Float?
  // Adresse du chantier : peut différer de l'adresse de facturation du client.
  address        String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tasks          ProjectTask[]
  taskGroups     ProjectTaskGroup[]
  taskCategories ProjectTaskCategory[]
  // TWO different kinds of category hang off a project, and both are reachable
  // from ProjectMaterial: taskCategories = phases of the WORKS,
  // materialCategories = the NATURE of the articles. Read
  // ProjectMaterialCategory own comment before touching either.
  materialCategories ProjectMaterialCategory[]
  folders        ProjectFolder[]
  files          ProjectFile[]
  materials      ProjectMaterial[]
  interventions  Intervention[]
  subcontractors SubcontractorCompany[]
  interims       Interim[]
  reservePlans   ReservePlan[]
  reservePlanFolders ReservePlanFolder[]
  // Monotonic issuer for réserve numbers. A counter, not max(number)+1: the
  // highest existing number drops when a réserve is deleted, which would hand
  // its number to a different défaut — and a report already sent cites it.
  reserveCounter Int                   @default(0)
  // Per-project presentation of the two réserve statuses. The ReserveStatus
  // enum itself is closed — exactly OPEN and RESOLVED — only their label and
  // colour are configurable.
  //
  // NULL is meaningful, and is the normal state: "not configured, use the
  // product default". The default lives in CODE, not in the database, so
  // these columns carry no @default on purpose:
  //   - the label falls back to the i18n dictionary (t.reserves.status.OPEN /
  //     .RESOLVED), which is per-locale — a single database DEFAULT would
  //     freeze one language for every locale;
  //   - the colour falls back to the shared constants (#e11d48 open,
  //     #16a34a resolved — today duplicated between the pin, the pill and
  //     lib/reservesReport.ts).
  // Storing the defaults in every row instead would make every project look
  // explicitly configured: the edit form could no longer tell "default" from
  // "custom", and changing the product default would reach nobody.
  //
  // Four scalar columns rather than a JSON blob or a child table: the set of
  // (status × attribute) pairs is closed and tiny, it is always read with the
  // project row itself (findById already returns the whole row), and each
  // value gets its own type and its own database CHECK. The day statuses
  // become user-defined, this becomes a child table keyed by
  // (projectId, statusId) — not before.
  //
  // Enforced by the database, not only by Zod (a psql session or an admin
  // script goes around Zod, never around a CHECK) — migration 20260823090000:
  //   *Color: NULL or /^#[0-9a-fA-F]{6}$/. These values are interpolated into
  //           a <style nonce> BLOCK (components/ReserveStatusStyleVars.tsx),
  //           so anything looser is a CSS injection vector — and a block is
  //           worse than an attribute: a stray "}" closes the rule and opens
  //           another. NOT into a style attribute: the CSP is
  //           "style-src self nonce-..." with no unsafe-inline, and a nonce
  //           authorises an ELEMENT, never an ATTRIBUTE. Rendering the colours
  //           by attribute is what PR #196 had to undo — do not reintroduce it
  //           on the strength of this comment. (Same rule as
  //           AppSettings.primaryColor, same safeHex guard at the sink.)
  //   *Label: NULL or a non-blank, control-character-free string of at most
  //           MAX_NAME_LENGTH (200, schemas/fields.ts). It is a one-line pill
  //           label rendered in HTML and drawn into the PDF report. The empty
  //           string is rejected so "not configured" has exactly ONE
  //           representation: NULL.
  reserveOpenLabel     String?
  reserveOpenColor     String?
  reserveResolvedLabel String?
  reserveResolvedColor String?
  // No index on those four: never filtered, sorted or joined on — they are
  // read as part of the project row, by primary key. Indexing a column that is
  // NULL for essentially every row and appears in no WHERE clause would only
  // tax every write to Project.
  // Contacts (client-portal logins) allowed to see this project.
  linkedContacts Contact[]             @relation("ContactProjects")
  // Internal users assigned to this project (see JobFunction.projectScope).
  assignedUsers  User[]                @relation("UserProjects")

  // Backs findByClient (the client detail page's project list) and the
  // Client onDelete: Cascade scan. Postgres does not auto-index FK columns.
  @@index([clientId])
  // GIN trigram index serving the case-insensitive `contains` filter on name
  // in repository/projects.ts::search (ILIKE '%term%'). Requires pg_trgm.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Project_name_trgm_idx")
}

// ---------------------------------------------------------------------------
// Guarded delivery of project-scoped Cloudinary assets
//
// ProjectFile / ReservePlan / ReservePhoto are delivered through an
// application route that re-checks access on every request, signs the
// Cloudinary URL server-side and streams the bytes. The stored delivery URL is
// therefore no longer replayed — it is REBUILT from the columns below, and the
// signed URL never reaches the browser.
//
// Out of scope on purpose, both stay public, for two DIFFERENT reasons:
// - AppSettings.logoUrl: the logo has to be fetchable from an email client,
//   which carries no session — it is meant to stay public.
// - Client.photoUrl: out of scope for this increment, not a product decision
//   either way. It is also only ever read in-app (ClientAvatar), so nothing
//   today requires it to be public. Unlike AppSettings (which already has a
//   logoPublicId column), Client has no publicId column at all —
//   destroyClientPhoto() re-derives it from the URL by regex — so guarding it
//   would need its own migration (add publicId, backfill, re-type on
//   Cloudinary), not just a code change. Left for a follow-up increment.
// ---------------------------------------------------------------------------

/// How Cloudinary delivers an asset. Mirrors Cloudinary's own `type` URL
/// segment, so the stored value is passed straight to cloudinary.url({ type })
/// — this is an API parameter, not a flag the application has to interpret.
/// UPLOAD is the legacy, publicly reachable state; AUTHENTICATED requires a
/// server-signed URL.
enum CloudinaryDeliveryType {
  UPLOAD
  AUTHENTICATED
}

/// Cloudinary's storage bucket for an asset. Recorded as used at upload time,
/// never re-derived at read time: it is NOT a function of the mime type — a
/// réserve plan is a PDF deliberately uploaded as an IMAGE so Cloudinary can
/// rasterise its pages (see lib/cloudinary.ts::uploadReservePlan).
enum CloudinaryResourceType {
  IMAGE
  VIDEO
  RAW
}

enum ReserveStatus {
  OPEN // réserve ouverte / à traiter
  RESOLVED // réserve levée
}

// A construction plan (uploaded as a PDF, rasterised by Cloudinary for
// display) on which "réserves" are pinned — FinalCad-style snagging. Many
// plans per project (e.g. one per floor). onDelete Cascade: deleting the
// project removes its plans and their pins.
// Optional folder to organise a project's reserve plans (e.g. "Bâtiment A").
// A flat, one-level grouping — a plan belongs to at most one folder.
model ReservePlanFolder {
  id        Int                 @id @default(autoincrement())
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  // Self-referential nesting, mirroring ProjectFolder in the Files module.
  // onDelete: Cascade so removing a folder takes its subfolders with it; the
  // plans inside them fall back to the project root via ReservePlan's own
  // SetNull, so nothing is ever deleted with the folder tree.
  parent    ReservePlanFolder?  @relation("ReserveFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  ReservePlanFolder[] @relation("ReserveFolderChildren")
  createdAt DateTime            @default(now())
  plans     ReservePlan[]

  // Composite backs findChildren (WHERE projectId AND parentId); the standalone
  // parentId backs the self-referential cascade scan on delete.
  @@index([projectId, parentId])
  @@index([parentId])
}

model ReservePlan {
  id        Int                @id @default(autoincrement())
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  // Optional folder. SetNull so deleting a folder just moves its plans back to
  // the project root rather than deleting them (and their réserves).
  folder    ReservePlanFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId  Int?
  name      String
  // DEPRECATED — legacy public secure_url of the PDF, dropped by the follow-up
  // migration. Nothing may read it: page rasterisation used to be done by
  // splicing "pg_N,f_jpg" into this string (lib/cloudinary-url.ts), which is
  // impossible on a signed URL — the transformation is now composed from
  // publicId BEFORE signing, server-side.
  url       String
  publicId  String
  // Guarded delivery — full contract on ProjectFile. resourceType is IMAGE
  // here even though the asset is a PDF: that is what makes `pg_N` work.
  deliveryType CloudinaryDeliveryType
  resourceType CloudinaryResourceType
  format       String?
  version      String?
  createdAt DateTime           @default(now())
  reserves  Reserve[]

  @@index([projectId])
  @@index([folderId])
}

// A pin dropped on a plan: a relative position (x/y in 0..1 so it survives
// any display size), a description, an open/resolved status and an optional
// GPS fix captured on site. onDelete Cascade with its plan.
model Reserve {
  id          Int            @id @default(autoincrement())
  plan        ReservePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      Int
  // Denormalised from the plan (a plan never changes project) purely so the
  // unique constraint below can exist: uniqueness has to be enforced by the
  // database, or two people pinning at the same moment get the same number.
  projectId   Int
  // Stable reference for the whole project, assigned once at creation and
  // never recomputed. It must NOT be a render-time index: a snagging report
  // sent to a contractor cites "réserve 7", so deleting réserve 3 must not
  // silently turn that into réserve 6. Numbers are therefore not reused.
  number      Int
  x           Float
  y           Float
  description String
  status      ReserveStatus  @default(OPEN)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime       @default(now())
  photos      ReservePhoto[]

  @@unique([projectId, number])
  @@index([planId])
}

// A photo attached to a réserve (Cloudinary image). Many per réserve.
// onDelete Cascade: deleting the réserve removes its photos.
model ReservePhoto {
  id        Int      @id @default(autoincrement())
  reserve   Reserve  @relation(fields: [reserveId], references: [id], onDelete: Cascade)
  reserveId Int
  // DEPRECATED — legacy public secure_url, dropped by the follow-up migration.
  url       String
  publicId  String
  // Guarded delivery — full contract on ProjectFile. There is no mimeType
  // column here, so `format` is also the only way to type the proxied response.
  deliveryType CloudinaryDeliveryType
  resourceType CloudinaryResourceType
  format       String?
  version      String?
  createdAt DateTime @default(now())

  // reserveId backs the réserve's photo list, the Cascade delete scan, and the
  // delivery route's project resolution (photo -> reserve.projectId, which the
  // Reserve model already denormalises — one hop, not two).
  @@index([reserveId])
}

model ProjectTask {
  id             Int               @id @default(autoincrement())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      Int
  // Set when this task was bulk-generated as part of a named series (see
  // ProjectTaskGroup) — null for a regular, individually-added task.
  group          ProjectTaskGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        Int?
  title          String
  done           Boolean           @default(false)
  // Optional quantity tracking for a standalone (ungrouped) task — when
  // quantityTarget is set, progress is entered as a count (quantityDone out
  // of quantityTarget) instead of a plain checkbox; done is kept in sync
  // (true once quantityDone reaches quantityTarget). Null for series tasks
  // and for standalone tasks that just use the checkbox.
  quantityTarget Int?
  quantityDone   Int?
  dueDate        DateTime?
  createdAt      DateTime          @default(now())
  materials      ProjectMaterial[]
  // Optional direct link to a category (e.g. "Toiture") for a standalone
  // task, same grouping series already have via ProjectTaskGroup.categoryId
  // — lets a lone quantity-tracked task sit alongside series under the same
  // category without needing to be wrapped in its own series.
  category       ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     Int?
  // Optional assignee — a task can be handled by EITHER a subcontractor
  // company OR an intérimaire (mutually exclusive, enforced in the action).
  // SetNull so deleting the assignee just clears the assignment.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // findByProject filters (projectId, groupId IS NULL); the group include
  // fetches WHERE groupId IN (...). The remaining FK indexes back the
  // SetNull/Cascade delete scans (deleting a category/company/interim/group
  // otherwise seq-scans this table across every project).
  @@index([projectId])
  @@index([groupId])
  @@index([categoryId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// A named, pattern-generated batch of tasks (e.g. "Strings onduleur" ->
// "String 1".."String 27"). Shown as a single row in the task list; deleting
// the group cascades to its tasks.
model ProjectTaskGroup {
  id         Int                  @id @default(autoincrement())
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  name       String
  pattern    String
  createdAt  DateTime             @default(now())
  tasks      ProjectTask[]
  materials  ProjectMaterial[]
  // Optional higher-level grouping of several series together (e.g. a
  // "Toiture" category containing the "Strings onduleur" and "Fixations"
  // series). SetNull rather than Cascade: deleting the category shouldn't
  // delete the series, just ungroup it.
  category   ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?
  // Optional assignee (subcontractor company OR intérimaire) for the whole
  // series — same rule as ProjectTask.assignedCompany/assignedInterim.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // projectId backs findByProject; the rest back SetNull/Cascade delete scans.
  @@index([projectId])
  @@index([categoryId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// Groups several ProjectTaskGroup series under one named category (e.g.
// "Toiture" containing "Strings onduleur" + "Fixations").
model ProjectTaskCategory {
  id        Int                @id @default(autoincrement())
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  createdAt DateTime           @default(now())
  groups    ProjectTaskGroup[]
  tasks     ProjectTask[]
  materials ProjectMaterial[]
  // Optional assignee (subcontractor company OR intérimaire) for the whole
  // category — same rule as ProjectTask.assignedCompany/assignedInterim.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // projectId backs findByProject; the rest back SetNull delete scans.
  @@index([projectId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// Self-referential tree: a folder can live at the project root (parentId
// null) or nest inside another folder of the same project.
model ProjectFolder {
  id        Int             @id @default(autoincrement())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  ProjectFolder[] @relation("FolderChildren")
  files     ProjectFile[]
  createdAt DateTime        @default(now())

  // The composite backs findChildren / collectDescendantFolderIds
  // (WHERE projectId AND parentId); the standalone parentId backs the
  // self-referential onDelete: Cascade scan when a folder is removed.
  @@index([projectId, parentId])
  @@index([parentId])
}

// A material NATURE, per project: Electricite, Couverture, Fixations... — how
// a conducteur de travaux files what he stores on a chantier, independently of
// the task that consumes it.
//
// READ THIS FIRST: THE WORD "CATEGORY" WAS ALREADY TAKEN NEXT DOOR.
// ProjectMaterial points at TWO different "category" models, and the other one
// got the word first. They answer different questions:
//
//   ProjectMaterial.taskCategoryId -> ProjectTaskCategory
//     "WHY is this material here?" — which phase of the works consumes it. One
//     of three mutually exclusive link targets (task / series / task category)
//     and, together with requiredQuantity, it drives the stock indicator
//     (red/orange/green, lib/materialStock.ts). ProjectTaskCategory also owns
//     tasks, task series and an assignee: it is a unit of WORK.
//
//   ProjectMaterial.materialCategoryId -> ProjectMaterialCategory (this model)
//     "WHAT is this material?" — filing, nothing else. It drives no stock
//     indicator, no progress figure, no assignment. It owns nothing but
//     materials.
//
// The two are independent, and carrying BOTH is the normal case rather than a
// contradiction: a breaker filed under "Electricite" (material category)
// needed for "Raccordement" (task category). Neither can be derived from the
// other, and clearing one must never clear the other.
//
// Modelled on ProjectTaskCategory — owned by exactly one project, cascade
// deleted with it, one name — minus everything that makes a task category a
// unit of work: no groups, no tasks, no assignedCompany/assignedInterim.
//
// Like ProjectTaskCategory, this table carries no cross-project guard of its
// own: nothing in the database stops a material of project A from being filed
// under a category of project B. The FK only proves the category exists. That
// invariant is the action layer job (resolve the category, check its projectId
// against the material own, 404 otherwise) — the same duty taskCategoryId
// already has. It is deliberately not a composite FK on (projectId, id): a
// composite FK with ON DELETE SET NULL nulls EVERY column of the key, which
// would try to null the NOT NULL projectId and turn a category deletion into a
// hard error.
//
// No @@unique([projectId, name]) on purpose. A plain unique would still admit
// "Electricite" next to "electricite " and "ELECTRICITE", so it would buy
// confidence it does not deliver; the constraint that would actually mean
// something is a functional unique index on (projectId, lower(btrim(name))),
// which Prisma cannot express in this file and which ProjectTaskCategory does
// not carry either. If duplicate names become a real complaint, add it as a
// raw index in its own migration — as a decision, de-duplicating the existing
// rows in the same transaction.
model ProjectMaterialCategory {
  id        Int               @id @default(autoincrement())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  // Non-blank, control-character-free, at most MAX_NAME_LENGTH (200,
  // schemas/fields.ts — the same "name or title" tier every other name in this
  // app uses; not a new number, so a category name and a task name cannot
  // drift apart). Enforced by a database CHECK in migration
  // 20260906120000_project_material_category, not only by Zod: an admin
  // script, a data fix or a psql session goes around Zod, never around a
  // CHECK. Same shape as the Project.reserve*Label CHECKs of 20260823090000.
  // The empty string is rejected so an unnamed category cannot masquerade as a
  // named one in a <select>.
  name      String
  createdAt DateTime          @default(now())
  materials ProjectMaterial[]

  // projectId backs the per-project category list AND the Project
  // onDelete: Cascade scan. Postgres does not auto-index a foreign key column:
  // without this, deleting one project sequentially scans this whole table.
  @@index([projectId])
}

// Inventory line for a project's equipment/material (panels, inverters,
// mounting hardware, ...). Quantity-only tracking — no per-unit status.
model ProjectMaterial {
  id               Int                  @id @default(autoincrement())
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        Int
  name             String
  // Quantity currently in stock.
  quantity         Float
  unit             String?
  supplierName     String?
  reference        String?
  // Optional link to the task, whole task series, or whole task category
  // this material is needed for (mutually exclusive) — when set,
  // requiredQuantity drives the stock indicator (red/orange/green in the
  // UI). SetNull rather than Cascade: deleting the task/series/category
  // shouldn't delete the material, just unlink it.
  task             ProjectTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId           Int?
  taskGroup        ProjectTaskGroup?    @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)
  taskGroupId      Int?
  taskCategory     ProjectTaskCategory? @relation(fields: [taskCategoryId], references: [id], onDelete: SetNull)
  taskCategoryId   Int?
  requiredQuantity Float?
  // WHAT this material is (Electricite, Couverture, Fixations...) — filing
  // only. This is NOT taskCategoryId a few lines above: that one says which
  // phase of the works the material is needed FOR and drives the stock
  // indicator; this one says what kind of article it is and drives nothing.
  // The two are independent and a material commonly carries both — see
  // ProjectMaterialCategory own comment for the full distinction.
  //
  // Optional, and NULL is a legitimate, PERMANENT state: "non classe". It is
  // not a hole waiting to be filled, which is why this column carries no
  // @default and why its migration deliberately performs NO backfill. Writing
  // a category into every existing row would invent a filing decision nobody
  // made, and would erase the difference between "not filed yet" and "filed
  // there on purpose".
  //
  // SetNull, exactly like the three link FKs above: deleting a category must
  // not delete the material filed under it. Those materials fall back to
  // "non classe" — a state they are already allowed to be in — so the deletion
  // costs the filing and nothing else.
  materialCategory   ProjectMaterialCategory? @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  materialCategoryId Int?
  createdAt        DateTime             @default(now())

  // projectId backs findMaterialsByProject; the link FKs back the SetNull
  // scans when a linked task/series/category is deleted.
  //
  // materialCategoryId earns its index twice over: it backs the SetNull scan
  // when a material category is deleted (without it, deleting one category
  // sequentially scans every material row of every project), and it backs the
  // grouped/filtered read this whole feature exists for
  // (WHERE "projectId" = $1 AND "materialCategoryId" = $2).
  @@index([projectId])
  @@index([taskId])
  @@index([taskGroupId])
  @@index([taskCategoryId])
  @@index([materialCategoryId])
}

enum InterventionStatus {
  PLANIFIEE
  FAITE
  ANNULEE
}

// A future on-site visit for a project (maintenance, inspection, install
// follow-up, ...) — independent of the task list, just a scheduled date +
// description tracked through to completion.
model Intervention {
  id          Int                @id @default(autoincrement())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  scheduledAt DateTime
  description String
  technician  String?
  status      InterventionStatus @default(PLANIFIEE)
  createdAt   DateTime           @default(now())

  @@index([projectId])
}

// A subcontracted company working on the project (e.g. an electrician or
// roofing firm) — a lightweight two-level structure mirroring
// ProjectTaskGroup/ProjectTask: the company is the "group", its personnel
// are the individual entries under it.
model SubcontractorCompany {
  id                 Int                   @id @default(autoincrement())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          Int
  name               String
  createdAt          DateTime              @default(now())
  personnel          SubcontractorPerson[]
  assignedTasks      ProjectTask[]
  assignedGroups     ProjectTaskGroup[]
  assignedCategories ProjectTaskCategory[]

  @@index([projectId])
}

model SubcontractorPerson {
  id            Int                  @id @default(autoincrement())
  company       SubcontractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     Int
  name          String
  // The person's job function, picked from the managed list (see JobFunction).
  // SetNull so deleting a function just clears it from its subcontractor people.
  jobFunction   JobFunction?         @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId Int?
  phone         String?
  createdAt     DateTime             @default(now())

  @@index([companyId])
  @@index([jobFunctionId])
}

// A temp/agency worker (intérimaire) attached directly to the project — a
// flat list (no company nesting like subcontractors), managed from the
// project's Intérimaires section and assignable to tasks.
model Interim {
  id                 Int                   @id @default(autoincrement())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          Int
  name               String
  // The intérimaire's job function, picked from the managed list (see
  // JobFunction). SetNull so deleting a function just clears it from its
  // intérimaires.
  jobFunction        JobFunction?          @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId      Int?
  agency             String?
  createdAt          DateTime              @default(now())
  assignedTasks      ProjectTask[]
  assignedGroups     ProjectTaskGroup[]
  assignedCategories ProjectTaskCategory[]

  @@index([projectId])
  @@index([jobFunctionId])
}

model ProjectFile {
  id        Int            @id @default(autoincrement())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  Int?
  name      String
  // DEPRECATED — the legacy public secure_url. Dead the moment the asset is
  // re-typed to `authenticated`, and misleading until then, so nothing may read
  // it any more: the delivery route builds its URL from
  // publicId + resourceType + format + version. Kept for exactly one release so
  // this change stays revertible, then dropped by the follow-up migration.
  url       String
  publicId  String
  // --- Guarded delivery. The contract, referenced by ReservePlan/ReservePhoto:
  //
  // deliveryType — no @default on purpose. Every create must state it, so no
  //   upload site can inherit a publicly reachable asset by omission; and while
  //   the one-shot re-typing script has not finished, this column is the only
  //   thing telling the delivery route whether to sign or not.
  // resourceType — see CloudinaryResourceType. Also the correct input for
  //   `destroy` calls, which silently no-op on a resource_type mismatch;
  //   ProjectFile currently re-derives it from the nullable, correctable
  //   mimeType, which is a coupling waiting to break.
  // format — the extension to append to publicId when building a delivery URL,
  //   without the dot ("pdf", "jpg"). Cloudinary strips the extension out of
  //   the public id of image/video resources but keeps it inside the public id
  //   of raw ones, so NULL here means "publicId already carries it" and is the
  //   normal state of a RAW row. Doubles as the response Content-Type source.
  // version — the "/v1753440000/" segment as returned at upload. Text, not a
  //   number: it is an opaque third-party token, never used in arithmetic.
  //   NULL = build the URL without a version segment.
  deliveryType CloudinaryDeliveryType
  resourceType CloudinaryResourceType
  format       String?
  version      String?
  size      Int?
  mimeType  String?
  createdAt DateTime       @default(now())

  // projectId backs project-scoped file queries; folderId backs
  // findFilesByFolder / collectDescendantFilePublicIds and the folder
  // onDelete: Cascade scan.
  @@index([projectId])
  @@index([folderId])
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
  // External client-portal login, tied to a Contact; confined to /portail and
  // scoped to the contact's linked projects. Below VIEWER in the hierarchy.
  CLIENT
}

// A configurable list of job functions / trades (manœuvre, électricien, chef de
// chantier, …) managed by ADMIN/SUPERADMIN. A reference list, not tied to a
// specific record yet — meant to become the source for the people "role"
// fields (contacts, subcontractor personnel, intérimaires).
/// Whether a job function sees every project or only the ones its holders are
/// assigned to. ALL is the default so adding this changes nothing for existing
/// functions — a permission model must never widen or narrow silently.
enum ProjectScope {
  ALL
  ASSIGNED
}

model JobFunction {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Manual display order, set by drag-and-drop on /fonctions.
  position  Int      @default(0)
  // Project-detail section keys (see lib/projectSections.ts) HIDDEN from users
  // who hold this function. Empty = hide nothing (see everything) — so a newly
  // added section is visible by default until an admin hides it.
  hiddenSections String[] @default([])
  // Top-level app area / sub-part keys (see lib/appAreas.ts) HIDDEN from users
  // who hold this function — a mirror of hiddenSections applied to the whole app
  // instead of a single project. Empty = hide nothing. Free strings validated
  // application-side, not a Postgres enum, exactly like hiddenSections.
  hiddenAreas String[] @default([])
  // Data axis, alongside hiddenSections' feature axis: which projects the
  // holders of this function may reach at all.
  projectScope ProjectScope @default(ALL)
  createdAt DateTime @default(now())
  users     User[]
  contacts  Contact[]
  interims  Interim[]
  subcontractorPeople SubcontractorPerson[]
}

model User {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  password      String
  name          String?
  role          Role                 @default(ADMIN)
  // The user's job function, picked from the managed list (see JobFunction).
  jobFunction   JobFunction?         @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId Int?
  // Set when this is a client-portal login (role CLIENT) tied to a contact.
  contact       Contact?
  createdAt     DateTime             @default(now())
  resetTokens   PasswordResetToken[]
  // Projects this user is assigned to. Only consulted when their function's
  // projectScope is ASSIGNED; mirrors the Contact↔Project link the client
  // portal already scopes with.
  assignedProjects Project[]          @relation("UserProjects")

  @@index([jobFunctionId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Singleton row (always id=1) holding app-wide branding/theme, configurable
// by a SUPERADMIN. One row for the whole app — this is a single-tenant
// starter, not a multi-tenant SaaS.
model AppSettings {
  id           Int      @id @default(1)
  appName      String   @default("Fullstack Starter")
  logoUrl      String?
  logoPublicId String?
  // Theme colours, enforced by the database and not only by Zod — migration
  // 20260828100000 adds CHECK ("primaryColor" ~ '^#[0-9a-fA-F]{6}$') and the
  // same on accentColor. Prisma cannot express a CHECK, so this comment is the
  // only trace of it for anyone reading the schema instead of the migration:
  // the constraint IS there in the database, do not conclude from a silent
  // schema that these two columns are unconstrained.
  //   - Shape: exactly #RRGGBB. Identical, character for character, to
  //     schemas/appSettings.ts's hexColor and lib/color.ts's safeHex. Both
  //     values are interpolated into the TEXT of a <style nonce> BLOCK in
  //     app/layout.tsx (:root{--primary:...}), so anything looser is a CSS
  //     injection vector — and a block is worse than an attribute: a stray "}"
  //     closes the rule and opens another. Not a style attribute: the CSP is
  //     "style-src 'self' 'nonce-...'" with no unsafe-inline, and a nonce
  //     authorises an ELEMENT, never an ATTRIBUTE. (Same rule and same sink as
  //     Project.reserveOpenColor / reserveResolvedColor, above.)
  //   - The CHECK has no "IS NULL OR" branch, unlike Project's: these two
  //     columns are NOT NULL. Making either nullable would silently make the
  //     constraint accept NULL — amend the CHECK in the same migration.
  //   - The DEFAULTs below are also the fallbacks safeHex is given at every
  //     sink; keep the two in sync, or a rejected stored value renders as one
  //     colour and a fresh row as another.
  primaryColor String   @default("#3b82f6")
  accentColor  String   @default("#8b5cf6")
  // Global display order of the project detail page's collapsible sections,
  // as an array of section keys (see lib/projectSections.ts). Empty = the
  // canonical default order; normalized on read so partial/stale values are
  // safe. Set by a SUPERADMIN via drag-and-drop on /admin/settings.
  projectSectionOrder String[] @default([])
  // RBAC matrix: capability -> minimum role, as a JSON object (see
  // lib/capabilities.ts). Empty = the defaults; merged/validated on read.
  accessConfig Json     @default("{}")
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  PERMANENTLY_DELETED
  IMPORTED
}

// No FK to Client: entries must survive a permanent deletion, so the client
// name is stored as a snapshot rather than joined at read time.
model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  clientId   Int?
  clientName String
  actorEmail String
  createdAt  DateTime       @default(now())

  // Append-only, never purged, always read ORDER BY createdAt DESC — index it.
  @@index([createdAt])
}

// Same snapshot approach as ActivityLog, for the projects module.
model ProjectActivityLog {
  id          Int            @id @default(autoincrement())
  action      ActivityAction
  projectId   Int?
  projectName String
  actorEmail  String
  createdAt   DateTime       @default(now())

  @@index([createdAt])
}
