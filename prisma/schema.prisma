// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  PROSPECT
  CLIENT
  INACTIVE
}

model Client {
  id Int @id @default(autoincrement())
  companyName String
  firstName String
  lastName String
  address String
  zipCode String
  city String
  country String
  email String  @unique
  photoUrl String?
  phone String?
  website String?
  status ClientStatus @default(PROSPECT)
  deletedAt DateTime?
  projects Project[]
}

enum ProjectStatus {
  ETUDE          // étude / devis en cours
  SIGNE          // devis signé
  EN_COURS       // installation en cours
  RACCORDEMENT   // en attente de raccordement / mise en service
  TERMINE        // chantier terminé
  ANNULE         // annulé
}

enum ProjectType {
  CENTRALE_AU_SOL
  OMBRIERE
  TOITURE
  AUTRE
}

model Project {
  id          Int           @id @default(autoincrement())
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int
  name        String
  type        ProjectType   @default(AUTRE)
  status      ProjectStatus @default(ETUDE)
  // Puissance crête en kWc, budget en euros — nullable tant que non chiffrés.
  power       Float?
  budget      Float?
  // Adresse du chantier : peut différer de l'adresse de facturation du client.
  address     String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       ProjectTask[]
  folders     ProjectFolder[]
  files       ProjectFile[]
}

model ProjectTask {
  id        Int       @id @default(autoincrement())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())
}

// Self-referential tree: a folder can live at the project root (parentId
// null) or nest inside another folder of the same project.
model ProjectFolder {
  id        Int             @id @default(autoincrement())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  ProjectFolder[] @relation("FolderChildren")
  files     ProjectFile[]
  createdAt DateTime        @default(now())
}

model ProjectFile {
  id        Int            @id @default(autoincrement())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  Int?
  name      String
  url       String
  publicId  String
  size      Int?
  mimeType  String?
  createdAt DateTime       @default(now())
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  PERMANENTLY_DELETED
  IMPORTED
}

// No FK to Client: entries must survive a permanent deletion, so the client
// name is stored as a snapshot rather than joined at read time.
model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  clientId   Int?
  clientName String
  actorEmail String
  createdAt  DateTime       @default(now())
}

