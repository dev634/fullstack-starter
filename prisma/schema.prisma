// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  PROSPECT
  CLIENT
  INACTIVE
}

// Persistent, DB-backed rate limiting (login/reset attempts). Deliberately
// just timestamped rows per key — "how many in the last N ms" is a plain
// count query, and this must be a genuine single source of truth shared
// across every request: Next.js can compile the same module into separate
// bundles for Server Actions vs Route Handlers, so a plain in-memory Map is
// NOT a reliable process-wide singleton and silently under-counts failures
// made through different call paths.
model RateLimitAttempt {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// An organisation/entreprise (company). Identified by companyName; its people
// live in Contact. email/phone are the company's own switchboard details,
// distinct from any contact's. The former person-identity columns
// (firstName/lastName) were migrated onto a primary Contact and dropped.
model Client {
  id          Int          @id @default(autoincrement())
  companyName String
  address     String
  zipCode     String
  city        String
  country     String
  email       String       @unique
  photoUrl    String?
  phone       String?
  website     String?
  status      ClientStatus @default(PROSPECT)
  deletedAt   DateTime?
  projects    Project[]
  contacts    Contact[]
}

// A person attached to an organisation — many per organisation. Each Client's
// former firstName/lastName/email/phone were migrated onto a primary Contact.
// onDelete Cascade: deleting the organisation removes its contacts.
model Contact {
  id            Int          @id @default(autoincrement())
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      Int
  firstName     String
  lastName      String
  email         String?
  phone         String?
  // The contact's job function, picked from the managed list (see JobFunction).
  // SetNull so deleting a function just clears it from its contacts.
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId Int?
  isPrimary     Boolean      @default(false)
  // Optional client-portal login for this contact (role CLIENT). SetNull so
  // deleting the login doesn't delete the contact.
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?         @unique
  // Projects of this contact's company the portal login may see (a subset).
  projects      Project[]    @relation("ContactProjects")
  createdAt     DateTime     @default(now())

  @@index([clientId])
  @@index([jobFunctionId])
}

enum ProjectStatus {
  ETUDE // étude / devis en cours
  SIGNE // devis signé
  EN_COURS // installation en cours
  RACCORDEMENT // en attente de raccordement / mise en service
  TERMINE // chantier terminé
  ANNULE // annulé
}

enum ProjectType {
  CENTRALE_AU_SOL
  OMBRIERE
  TOITURE
  AUTRE
}

model Project {
  id             Int                   @id @default(autoincrement())
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       Int
  name           String
  // Numéro d'affaire : référence métier libre du projet (nullable).
  businessNumber String?
  type           ProjectType           @default(AUTRE)
  status         ProjectStatus         @default(ETUDE)
  // Puissance crête en kWc, budget en euros — nullable tant que non chiffrés.
  power          Float?
  budget         Float?
  // Adresse du chantier : peut différer de l'adresse de facturation du client.
  address        String?
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tasks          ProjectTask[]
  taskGroups     ProjectTaskGroup[]
  taskCategories ProjectTaskCategory[]
  folders        ProjectFolder[]
  files          ProjectFile[]
  materials      ProjectMaterial[]
  interventions  Intervention[]
  subcontractors SubcontractorCompany[]
  interims       Interim[]
  reservePlans   ReservePlan[]
  reservePlanFolders ReservePlanFolder[]
  // Monotonic issuer for réserve numbers. A counter, not max(number)+1: the
  // highest existing number drops when a réserve is deleted, which would hand
  // its number to a different défaut — and a report already sent cites it.
  reserveCounter Int                   @default(0)
  // Contacts (client-portal logins) allowed to see this project.
  linkedContacts Contact[]             @relation("ContactProjects")
  // Internal users assigned to this project (see JobFunction.projectScope).
  assignedUsers  User[]                @relation("UserProjects")

  // Backs findByClient (the client detail page's project list) and the
  // Client onDelete: Cascade scan. Postgres does not auto-index FK columns.
  @@index([clientId])
}

enum ReserveStatus {
  OPEN // réserve ouverte / à traiter
  RESOLVED // réserve levée
}

// A construction plan (uploaded as a PDF, rasterised by Cloudinary for
// display) on which "réserves" are pinned — FinalCad-style snagging. Many
// plans per project (e.g. one per floor). onDelete Cascade: deleting the
// project removes its plans and their pins.
// Optional folder to organise a project's reserve plans (e.g. "Bâtiment A").
// A flat, one-level grouping — a plan belongs to at most one folder.
model ReservePlanFolder {
  id        Int           @id @default(autoincrement())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  createdAt DateTime      @default(now())
  plans     ReservePlan[]

  @@index([projectId])
}

model ReservePlan {
  id        Int                @id @default(autoincrement())
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  // Optional folder. SetNull so deleting a folder just moves its plans back to
  // the project root rather than deleting them (and their réserves).
  folder    ReservePlanFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId  Int?
  name      String
  // Cloudinary secure_url of the PDF (stored as an image resource so its
  // pages can be delivered as images) + public id for deletion.
  url       String
  publicId  String
  createdAt DateTime           @default(now())
  reserves  Reserve[]

  @@index([projectId])
  @@index([folderId])
}

// A pin dropped on a plan: a relative position (x/y in 0..1 so it survives
// any display size), a description, an open/resolved status and an optional
// GPS fix captured on site. onDelete Cascade with its plan.
model Reserve {
  id          Int            @id @default(autoincrement())
  plan        ReservePlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId      Int
  // Denormalised from the plan (a plan never changes project) purely so the
  // unique constraint below can exist: uniqueness has to be enforced by the
  // database, or two people pinning at the same moment get the same number.
  projectId   Int
  // Stable reference for the whole project, assigned once at creation and
  // never recomputed. It must NOT be a render-time index: a snagging report
  // sent to a contractor cites "réserve 7", so deleting réserve 3 must not
  // silently turn that into réserve 6. Numbers are therefore not reused.
  number      Int
  x           Float
  y           Float
  description String
  status      ReserveStatus  @default(OPEN)
  latitude    Float?
  longitude   Float?
  createdAt   DateTime       @default(now())
  photos      ReservePhoto[]

  @@unique([projectId, number])
  @@index([planId])
}

// A photo attached to a réserve (Cloudinary image). Many per réserve.
// onDelete Cascade: deleting the réserve removes its photos.
model ReservePhoto {
  id        Int      @id @default(autoincrement())
  reserve   Reserve  @relation(fields: [reserveId], references: [id], onDelete: Cascade)
  reserveId Int
  url       String
  publicId  String
  createdAt DateTime @default(now())

  @@index([reserveId])
}

model ProjectTask {
  id             Int               @id @default(autoincrement())
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      Int
  // Set when this task was bulk-generated as part of a named series (see
  // ProjectTaskGroup) — null for a regular, individually-added task.
  group          ProjectTaskGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        Int?
  title          String
  done           Boolean           @default(false)
  // Optional quantity tracking for a standalone (ungrouped) task — when
  // quantityTarget is set, progress is entered as a count (quantityDone out
  // of quantityTarget) instead of a plain checkbox; done is kept in sync
  // (true once quantityDone reaches quantityTarget). Null for series tasks
  // and for standalone tasks that just use the checkbox.
  quantityTarget Int?
  quantityDone   Int?
  dueDate        DateTime?
  createdAt      DateTime          @default(now())
  materials      ProjectMaterial[]
  // Optional direct link to a category (e.g. "Toiture") for a standalone
  // task, same grouping series already have via ProjectTaskGroup.categoryId
  // — lets a lone quantity-tracked task sit alongside series under the same
  // category without needing to be wrapped in its own series.
  category       ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     Int?
  // Optional assignee — a task can be handled by EITHER a subcontractor
  // company OR an intérimaire (mutually exclusive, enforced in the action).
  // SetNull so deleting the assignee just clears the assignment.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // findByProject filters (projectId, groupId IS NULL); the group include
  // fetches WHERE groupId IN (...). The remaining FK indexes back the
  // SetNull/Cascade delete scans (deleting a category/company/interim/group
  // otherwise seq-scans this table across every project).
  @@index([projectId])
  @@index([groupId])
  @@index([categoryId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// A named, pattern-generated batch of tasks (e.g. "Strings onduleur" ->
// "String 1".."String 27"). Shown as a single row in the task list; deleting
// the group cascades to its tasks.
model ProjectTaskGroup {
  id         Int                  @id @default(autoincrement())
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  Int
  name       String
  pattern    String
  createdAt  DateTime             @default(now())
  tasks      ProjectTask[]
  materials  ProjectMaterial[]
  // Optional higher-level grouping of several series together (e.g. a
  // "Toiture" category containing the "Strings onduleur" and "Fixations"
  // series). SetNull rather than Cascade: deleting the category shouldn't
  // delete the series, just ungroup it.
  category   ProjectTaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?
  // Optional assignee (subcontractor company OR intérimaire) for the whole
  // series — same rule as ProjectTask.assignedCompany/assignedInterim.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // projectId backs findByProject; the rest back SetNull/Cascade delete scans.
  @@index([projectId])
  @@index([categoryId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// Groups several ProjectTaskGroup series under one named category (e.g.
// "Toiture" containing "Strings onduleur" + "Fixations").
model ProjectTaskCategory {
  id        Int                @id @default(autoincrement())
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  createdAt DateTime           @default(now())
  groups    ProjectTaskGroup[]
  tasks     ProjectTask[]
  materials ProjectMaterial[]
  // Optional assignee (subcontractor company OR intérimaire) for the whole
  // category — same rule as ProjectTask.assignedCompany/assignedInterim.
  assignedCompany   SubcontractorCompany? @relation(fields: [assignedCompanyId], references: [id], onDelete: SetNull)
  assignedCompanyId Int?
  assignedInterim   Interim?              @relation(fields: [assignedInterimId], references: [id], onDelete: SetNull)
  assignedInterimId Int?

  // projectId backs findByProject; the rest back SetNull delete scans.
  @@index([projectId])
  @@index([assignedCompanyId])
  @@index([assignedInterimId])
}

// Self-referential tree: a folder can live at the project root (parentId
// null) or nest inside another folder of the same project.
model ProjectFolder {
  id        Int             @id @default(autoincrement())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  name      String
  parent    ProjectFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  Int?
  children  ProjectFolder[] @relation("FolderChildren")
  files     ProjectFile[]
  createdAt DateTime        @default(now())

  // The composite backs findChildren / collectDescendantFolderIds
  // (WHERE projectId AND parentId); the standalone parentId backs the
  // self-referential onDelete: Cascade scan when a folder is removed.
  @@index([projectId, parentId])
  @@index([parentId])
}

// Inventory line for a project's equipment/material (panels, inverters,
// mounting hardware, ...). Quantity-only tracking — no per-unit status.
model ProjectMaterial {
  id               Int                  @id @default(autoincrement())
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        Int
  name             String
  // Quantity currently in stock.
  quantity         Float
  unit             String?
  supplierName     String?
  reference        String?
  // Optional link to the task, whole task series, or whole task category
  // this material is needed for (mutually exclusive) — when set,
  // requiredQuantity drives the stock indicator (red/orange/green in the
  // UI). SetNull rather than Cascade: deleting the task/series/category
  // shouldn't delete the material, just unlink it.
  task             ProjectTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId           Int?
  taskGroup        ProjectTaskGroup?    @relation(fields: [taskGroupId], references: [id], onDelete: SetNull)
  taskGroupId      Int?
  taskCategory     ProjectTaskCategory? @relation(fields: [taskCategoryId], references: [id], onDelete: SetNull)
  taskCategoryId   Int?
  requiredQuantity Float?
  createdAt        DateTime             @default(now())

  // projectId backs findMaterialsByProject; the link FKs back the SetNull
  // scans when a linked task/series/category is deleted.
  @@index([projectId])
  @@index([taskId])
  @@index([taskGroupId])
  @@index([taskCategoryId])
}

enum InterventionStatus {
  PLANIFIEE
  FAITE
  ANNULEE
}

// A future on-site visit for a project (maintenance, inspection, install
// follow-up, ...) — independent of the task list, just a scheduled date +
// description tracked through to completion.
model Intervention {
  id          Int                @id @default(autoincrement())
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   Int
  scheduledAt DateTime
  description String
  technician  String?
  status      InterventionStatus @default(PLANIFIEE)
  createdAt   DateTime           @default(now())

  @@index([projectId])
}

// A subcontracted company working on the project (e.g. an electrician or
// roofing firm) — a lightweight two-level structure mirroring
// ProjectTaskGroup/ProjectTask: the company is the "group", its personnel
// are the individual entries under it.
model SubcontractorCompany {
  id                 Int                   @id @default(autoincrement())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          Int
  name               String
  createdAt          DateTime              @default(now())
  personnel          SubcontractorPerson[]
  assignedTasks      ProjectTask[]
  assignedGroups     ProjectTaskGroup[]
  assignedCategories ProjectTaskCategory[]

  @@index([projectId])
}

model SubcontractorPerson {
  id        Int                  @id @default(autoincrement())
  company   SubcontractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int
  name      String
  role      String?
  phone     String?
  createdAt DateTime             @default(now())

  @@index([companyId])
}

// A temp/agency worker (intérimaire) attached directly to the project — a
// flat list (no company nesting like subcontractors), managed from the
// project's Intérimaires section and assignable to tasks.
model Interim {
  id                 Int                   @id @default(autoincrement())
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          Int
  name               String
  role               String?
  agency             String?
  createdAt          DateTime              @default(now())
  assignedTasks      ProjectTask[]
  assignedGroups     ProjectTaskGroup[]
  assignedCategories ProjectTaskCategory[]

  @@index([projectId])
}

model ProjectFile {
  id        Int            @id @default(autoincrement())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  folder    ProjectFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId  Int?
  name      String
  url       String
  publicId  String
  size      Int?
  mimeType  String?
  createdAt DateTime       @default(now())

  // projectId backs project-scoped file queries; folderId backs
  // findFilesByFolder / collectDescendantFilePublicIds and the folder
  // onDelete: Cascade scan.
  @@index([projectId])
  @@index([folderId])
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
  // External client-portal login, tied to a Contact; confined to /portail and
  // scoped to the contact's linked projects. Below VIEWER in the hierarchy.
  CLIENT
}

// A configurable list of job functions / trades (manœuvre, électricien, chef de
// chantier, …) managed by ADMIN/SUPERADMIN. A reference list, not tied to a
// specific record yet — meant to become the source for the people "role"
// fields (contacts, subcontractor personnel, intérimaires).
/// Whether a job function sees every project or only the ones its holders are
/// assigned to. ALL is the default so adding this changes nothing for existing
/// functions — a permission model must never widen or narrow silently.
enum ProjectScope {
  ALL
  ASSIGNED
}

model JobFunction {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  // Manual display order, set by drag-and-drop on /fonctions.
  position  Int      @default(0)
  // Project-detail section keys (see lib/projectSections.ts) HIDDEN from users
  // who hold this function. Empty = hide nothing (see everything) — so a newly
  // added section is visible by default until an admin hides it.
  hiddenSections String[] @default([])
  // Data axis, alongside hiddenSections' feature axis: which projects the
  // holders of this function may reach at all.
  projectScope ProjectScope @default(ALL)
  createdAt DateTime @default(now())
  users     User[]
  contacts  Contact[]
}

model User {
  id            Int                  @id @default(autoincrement())
  email         String               @unique
  password      String
  name          String?
  role          Role                 @default(ADMIN)
  // The user's job function, picked from the managed list (see JobFunction).
  jobFunction   JobFunction?         @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId Int?
  // Set when this is a client-portal login (role CLIENT) tied to a contact.
  contact       Contact?
  createdAt     DateTime             @default(now())
  resetTokens   PasswordResetToken[]
  // Projects this user is assigned to. Only consulted when their function's
  // projectScope is ASSIGNED; mirrors the Contact↔Project link the client
  // portal already scopes with.
  assignedProjects Project[]          @relation("UserProjects")

  @@index([jobFunctionId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Singleton row (always id=1) holding app-wide branding/theme, configurable
// by a SUPERADMIN. One row for the whole app — this is a single-tenant
// starter, not a multi-tenant SaaS.
model AppSettings {
  id           Int      @id @default(1)
  appName      String   @default("Fullstack Starter")
  logoUrl      String?
  logoPublicId String?
  primaryColor String   @default("#3b82f6")
  accentColor  String   @default("#8b5cf6")
  // Global display order of the project detail page's collapsible sections,
  // as an array of section keys (see lib/projectSections.ts). Empty = the
  // canonical default order; normalized on read so partial/stale values are
  // safe. Set by a SUPERADMIN via drag-and-drop on /admin/settings.
  projectSectionOrder String[] @default([])
  // RBAC matrix: capability -> minimum role, as a JSON object (see
  // lib/capabilities.ts). Empty = the defaults; merged/validated on read.
  accessConfig Json     @default("{}")
  updatedAt    DateTime @updatedAt
  updatedBy    String?
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
  PERMANENTLY_DELETED
  IMPORTED
}

// No FK to Client: entries must survive a permanent deletion, so the client
// name is stored as a snapshot rather than joined at read time.
model ActivityLog {
  id         Int            @id @default(autoincrement())
  action     ActivityAction
  clientId   Int?
  clientName String
  actorEmail String
  createdAt  DateTime       @default(now())
}

// Same snapshot approach as ActivityLog, for the projects module.
model ProjectActivityLog {
  id          Int            @id @default(autoincrement())
  action      ActivityAction
  projectId   Int?
  projectName String
  actorEmail  String
  createdAt   DateTime       @default(now())
}
